{
  "name": "slacker",
  "version": "0.1.0",
  "description": "Slack status synchronizer with GitHub and Linear",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit --rootDir .",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@slack/web-api": "^7.19.0",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.12.7",
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
